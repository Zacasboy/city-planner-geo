# Copiar para .env (nunca commitar .env). Preencher com valores reais localmente.

# Aplicação
APP_ENV=development
LOG_LEVEL=INFO

# Supabase
# Dashboard -> Project Settings -> API Keys (as antigas anon/service_role estão em descontinuação)
SUPABASE_URL=
# sb_publishable_...: segura para cliente, limitada pela RLS
SUPABASE_PUBLISHABLE_KEY=
# sb_secret_...: só backend/workers, ignora a RLS. Nunca no frontend nem no Git
SUPABASE_SECRET_KEY=
# A T1.2 decide como validar o JWT dos utilizadores (JWKS ou segredo); só então usar:
# SUPABASE_JWT_SECRET=

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Hugging Face (streaming de datasets)
HF_TOKEN=

# Copernicus CLMS (v1.0, a confirmar em T0.5)
COPERNICUS_API_KEY=

# Observabilidade
SENTRY_DSN=
