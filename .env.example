# Copiar para .env (nunca commitar .env). Preencher com valores reais localmente.

# Aplicação
APP_ENV=development
LOG_LEVEL=INFO
# Servidor: por omissão só escuta localmente; em contentor usar HOST=0.0.0.0
# HOST=127.0.0.1
# Origens CORS permitidas, lista JSON. "*" é rejeitado (a API usa credenciais)
# BACKEND_CORS_ORIGINS=["http://localhost:8501"]

# Supabase
# Dashboard -> Project Settings -> API Keys (as antigas anon/service_role estão em descontinuação)
SUPABASE_URL=
# sb_publishable_...: segura para cliente, limitada pela RLS
SUPABASE_PUBLISHABLE_KEY=
# sb_secret_...: só backend/workers, ignora a RLS. Nunca no frontend nem no Git
SUPABASE_SECRET_KEY=
# Validação dos JWT dos utilizadores (T1.2). Com chaves assimétricas (ES256/RS256, o padrão
# dos projetos novos) usa-se o JWKS em <SUPABASE_URL>/auth/v1/.well-known/jwks.json e nada
# mais é preciso. Só em projetos com segredo partilhado (HS256) definir:
# SUPABASE_JWT_SECRET=
# O `aud` esperado é "authenticated" e o `iss` "<SUPABASE_URL>/auth/v1"; só mudar se o
# projeto usar um domínio próprio:
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_ISSUER=

# APIs públicas (sem chave)
# DGT_REGIME_FLORESTAL_URL=https://infogeo.dgterritorio.gov.pt/arcgis/rest/services/Hosted/Regime_florestal/FeatureServer/1562
# GBIF_USER_AGENT=city-planner-geo/0.1.0 (contacto: o-seu-email@exemplo.com)

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Hugging Face (streaming de datasets)
HF_TOKEN=

# Copernicus CLMS (v1.0, a confirmar em T0.5)
COPERNICUS_API_KEY=

# Observabilidade
SENTRY_DSN=
